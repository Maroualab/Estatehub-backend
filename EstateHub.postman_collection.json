}
]
},
{
"name": "📝 Leases",
"item": [
{
"name": "1. Create Lease",
"event": [{"listen": "test","script": {"exec": ["if (pm.response.code === 200) {","    var json = pm.response.json();","    pm.collectionVariables.set('leaseId', json.id);","    console.log('✅ leaseId saved: ' + json.id);","    console.log('totalMonthlyPayment: ' + json.totalMonthlyPayment);","}"],"type": "text/javascript"}}],
"request": {"method": "POST","header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{accessToken}}"}],"body": {"mode": "raw","raw": "{\n    \"startDate\": \"2026-03-01\",\n    \"endDate\": \"2027-03-01\",\n    \"baseRentAmount\": 850.00,\n    \"utilityAmount\": 150.00,\n    \"unitId\": {{unitId}},\n    \"tenantEmail\": \"tenant@test.com\"\n}"},"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Create a lease. Response includes totalMonthlyPayment = baseRentAmount + utilityAmount (computed automatically). Lease ID is auto-saved."}
},
{
"name": "2. Create Lease (Unit Already Active — Should Fail)",
"request": {"method": "POST","header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{accessToken}}"}],"body": {"mode": "raw","raw": "{\n    \"startDate\": \"2026-06-01\",\n    \"endDate\": \"2027-06-01\",\n    \"baseRentAmount\": 900.00,\n    \"utilityAmount\": 100.00,\n    \"unitId\": {{unitId}},\n    \"tenantEmail\": \"tenant@test.com\"\n}"},"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Should fail 400 — the unit already has an ACTIVE lease. Run #1 first."}
},
{
"name": "3. Create Lease (Unknown Tenant — Should Fail)",
"request": {"method": "POST","header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{accessToken}}"}],"body": {"mode": "raw","raw": "{\n    \"startDate\": \"2026-04-01\",\n    \"endDate\": \"2027-04-01\",\n    \"baseRentAmount\": 700.00,\n    \"utilityAmount\": 100.00,\n    \"unitId\": {{unitId}},\n    \"tenantEmail\": \"doesnotexist@test.com\"\n}"},"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Should fail 404 — tenant email doesn't exist in DB."}
},
{
"name": "4. Create Lease (Non-existent Unit — Should Fail)",
"request": {"method": "POST","header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{accessToken}}"}],"body": {"mode": "raw","raw": "{\n    \"startDate\": \"2026-04-01\",\n    \"endDate\": \"2027-04-01\",\n    \"baseRentAmount\": 700.00,\n    \"utilityAmount\": 100.00,\n    \"unitId\": 99999,\n    \"tenantEmail\": \"tenant@test.com\"\n}"},"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Should fail 404 — unit 99999 doesn't exist."}
},
{
"name": "5. Create Lease (Validation Errors — Should Fail)",
"request": {"method": "POST","header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{accessToken}}"}],"body": {"mode": "raw","raw": "{\n    \"baseRentAmount\": -50.00,\n    \"utilityAmount\": 100.00,\n    \"unitId\": {{unitId}},\n    \"tenantEmail\": \"not-an-email\"\n}"},"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Should fail 400 — startDate missing, baseRentAmount negative, invalid tenantEmail format."}
},
{
"name": "6. Get My Leases",
"request": {"method": "GET","header": [{"key": "Authorization","value": "Bearer {{accessToken}}"}],"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "List all leases for the authenticated landlord. Each entry includes totalMonthlyPayment."}
},
{
"name": "7. Get Leases (No Token — Should Fail)",
"request": {"method": "GET","header": [],"url": {"raw": "{{baseUrl}}/api/leases","host": ["{{baseUrl}}"],"path": ["api","leases"]},"description": "Should fail 403 — no JWT."}
}
]
